# Секреты скиллов — только из окружения, никогда в репозиторий
.env
.env.*
!.env.example
**/config/.env
**/config/.env.*
!**/config/.env.example

# Локальные копии контекста проекта (заполняются из *.template.md)
.claude/skills/yandex-direct/references/PRODUCT_CONTEXT.md
.claude/skills/yandex-direct/references/KEYWORDS_SOURCE.md

# OS / editor
.DS_Store
*.swp

# node
node_modules/
dist/
.next/
*.tsbuildinfo

# prisma
packages/db/prisma/*.db

# Резервные копии мутационных прогонов: временный файл, в репозиторий не попадает.
# Однажды такой файл уехал в коммит вместе со снятой проверкой — правило вместо памяти.
*.mutbak
