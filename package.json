{
  "name": "sdelka",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @sdelka/db generate",
    "db:migrate": "pnpm --filter @sdelka/db migrate"
  }
}
