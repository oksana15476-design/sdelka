{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Интеграционный набор подключает `@sdelka/db` — единственный пакет, у
    // которого есть запускаемые команды (`pnpm db:migrate`, `db:generate`) и
    // потому относительные импорты с явным `.ts` (см. его `tsconfig.json`).
    // Проверка типов идёт и по импортированным файлам, поэтому послабление
    // нужно здесь, а не только там. Требование `noEmit` соблюдено: этот пакет
    // ничего не собирает.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["test/**/*.ts"]
}
