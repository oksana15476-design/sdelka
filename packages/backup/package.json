{
  "name": "@sdelka/backup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "dump": "node --import ./src/cli/register-ts.mjs --experimental-strip-types src/cli/dump.ts",
    "verify": "node --import ./src/cli/register-ts.mjs --experimental-strip-types src/cli/verify.ts"
  },
  "dependencies": {
    "@sdelka/audit": "workspace:*",
    "@sdelka/db": "workspace:*",
    "@sdelka/ledger": "workspace:*",
    "@sdelka/money": "workspace:*",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/pg": "8.11.10"
  }
}
