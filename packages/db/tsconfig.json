{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Пакет содержит запускаемые команды (`pnpm db:migrate`, `db:generate`),
    // которые node исполняет напрямую со снятием типов. Node — не сборщик: он
    // требует расширение в спецификаторе. Поэтому относительные импорты здесь
    // с явным `.ts`, и это локальное отличие от остальных пакетов, у которых
    // исполняемых входных точек нет.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
