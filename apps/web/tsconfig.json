{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "noEmit": true,
    // `@sdelka/db` — единственная зависимость интерфейса, у которой есть
    // запускаемые команды (`pnpm db:migrate`), поэтому её относительные импорты
    // с явным `.ts` (см. `packages/db/tsconfig.json`). Интерфейс её тянет ради
    // проверки здоровья `/health`, и без этого флага `tsc` роняет чужие файлы
    // на TS5097. Сборке это ничего не меняет: `noEmit` уже стоит, разрешение
    // модулей у Next то же самое.
    "allowImportingTsExtensions": true,
    "declaration": false,
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "incremental": true,
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
