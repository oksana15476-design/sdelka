# Переменные окружения проекта «Сделка» — полный перечень.
#
# ЭТОТ ФАЙЛ НЕ СОДЕРЖИТ НИ ОДНОГО ЗНАЧЕНИЯ И НЕ БУДЕТ СОДЕРЖАТЬ (красная линия
# №12). Здесь имена, ответ «что будет, если не задана», и способ получить
# значение. Значения живут в окружении: в хранилище секретов, в менеджере
# паролей, в переменных запуска — где угодно, кроме репозитория и его истории.
#
# Как пользоваться:
#   cp .env.example .env     # .env в .gitignore, туда можно вписывать значения
#   pnpm env:check           # ворота старта: не хватает обязательной — код 1
#
# Обязательность помечена в заголовке каждой переменной:
#   [обязательна]    — процесс приложения без неё не поднимается;
#   [необязательна]  — у читателя есть объявленное поведение без неё;
#   [секрет]         — значение не печатается никогда: ни в журнал, ни в отказ.
#
# Перечень сверяется с деревом автоматически: `packages/config/src/registry.ts`
# — единственный источник, `packages/config/test` не даёт им разъехаться. Новая
# переменная, прочитанная кодом или скриптом мимо перечня, роняет тесты.

# ─────────────────────────────────────────────────────────────────────────────
# База данных
# ─────────────────────────────────────────────────────────────────────────────

# SDELKA_DATABASE_URL [обязательна] [секрет]
# Что это: строка подключения к Postgres. Одна на всё — миграции,
#   интеграционные тесты и приложение читают её же. Разделение прав держат роли
#   схемы (packages/db/src/roles.ts), а не вторая строка подключения.
# Если не задана: приложение и `pnpm db:migrate` не поднимаются (отказ с именем
#   переменной). Интеграционные наборы (`test:int`) сами себя пропускают —
#   пропуск громкий, с причиной; «N skipped» не считается зелёным прогоном.
# Если задана пустой: то же, что «не задана», но отказ говорит это отдельным
#   ключом — вы её завели, значит опечатка не в имени.
# Где взять: локально — `bash packages/db/scripts/dev-db.sh`, скрипт напечатает
#   готовую строку. На стенде и в проде — у того, кто держит базу; строка
#   приходит из хранилища секретов, не из переписки и не отсюда.
SDELKA_DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Локальный кластер для интеграционных тестов
# packages/db/scripts/dev-db.sh. В проде эти переменные не нужны ни одной.
# ─────────────────────────────────────────────────────────────────────────────

# SDELKA_DB_NAME [необязательна]
# Что это: имя базы, которую заводит скрипт локального кластера.
# Если не задана: скрипт берёт своё имя по умолчанию (см. сам скрипт).
# Где взять: назначаете сами; нужно, только если на машине уже занято.
SDELKA_DB_NAME=

# SDELKA_DB_USER [необязательна]
# Что это: имя логин-роли, которую заводит скрипт. Роль входит и в группу
#   владельца, и в группу приложения: она применяет миграции и играет
#   приложение в тестах.
# Если не задана: скрипт берёт своё имя по умолчанию (см. сам скрипт).
# Где взять: назначаете сами.
SDELKA_DB_USER=

# SDELKA_DB_HOST [необязательна]
# Что это: хост в строке подключения, которую печатает скрипт.
# Если не задана: локальная петля.
# Где взять: назначаете сами; нужно, если кластер не на этой машине.
SDELKA_DB_HOST=

# SDELKA_DB_PORT [необязательна]
# Что это: порт в строке подключения, которую печатает скрипт.
# Если не задана: штатный порт Postgres.
# Где взять: `pg_lsclusters` покажет порт вашего кластера.
SDELKA_DB_PORT=

# SDELKA_PG_CLUSTER [необязательна]
# Что это: версия и имя кластера для `pg_ctlcluster` — что поднимать, если
#   кластер не поднят.
# Если не задана: скрипт берёт свой кластер по умолчанию (см. сам скрипт).
# Где взять: `pg_lsclusters`, первые две колонки.
SDELKA_PG_CLUSTER=

# SDELKA_DB_PASSWORD [необязательна] [секрет]
# Что это: пароль локальной логин-роли. Стек из контейнеров (`compose.yaml`,
#   `docs/DEPLOY.md`) читает её же: там она заводит роль в Postgres и собирает
#   строку подключения для приложения и наката.
# Если не задана: пароль не назначается вовсе, роль работает по peer-проверке
#   от имени пользователя ОС. Умолчания у этой переменной нет и не будет:
#   пароль по умолчанию — это пароль в репозитории. Стек из контейнеров без неё
#   не поднимается вовсе и называет её по имени.
# Где взять: придумываете сами и держите в менеджере паролей; для стека пароль
#   обязан быть безопасным для URL — генератор в `docs/DEPLOY.md`. Пароль от
#   боевой базы сюда не кладут никогда — эта переменная только про локальный
#   кластер.
SDELKA_DB_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Мутационные стенды. Ставятся самими сценариями прогона, руками — только когда
# воспроизводите один мутант.
# ─────────────────────────────────────────────────────────────────────────────

# SDELKA_MUTATE_LEDGER [необязательна]
# Что это: идентификатор мутанта учёта, который стенд вносит в код на один прогон.
# Если не задана: код не мутируется, набор идёт как обычно.
# Где взять: из перечня мутантов, `packages/ledger/scripts/ledger-mutants.mjs`.
SDELKA_MUTATE_LEDGER=

# SDELKA_MUTATE_INTAKE [необязательна]
# Что это: то же для приёмки.
# Если не задана: код не мутируется.
# Где взять: `packages/intake/scripts/intake-mutants.mjs`.
SDELKA_MUTATE_INTAKE=

# SDELKA_MUTATE_COMPLIANCE [необязательна]
# Что это: то же для проверок соответствия.
# Если не задана: код не мутируется.
# Где взять: `packages/compliance/scripts/compliance-mutants.mjs`.
SDELKA_MUTATE_COMPLIANCE=

# SDELKA_MUTATE_GUARD [необязательна]
# Что это: признак прогона со снятым guard'ом сквозного контура.
# Если не задана: guard'ы на месте.
# Где взять: ставится сценарием `packages/e2e/scripts/guard-mutation.mjs`.
SDELKA_MUTATE_GUARD=

# SDELKA_MUTATE_GUARD_TARGET [необязательна]
# Что это: какой именно guard снимается на прогон.
# Если не задана: не снимается ни один.
# Где взять: перечень целей, `packages/e2e/scripts/guard-registry.mjs`.
SDELKA_MUTATE_GUARD_TARGET=

# ─────────────────────────────────────────────────────────────────────────────
# Обход интерфейса. apps/web/scripts/verify-ui.mjs, только разработка.
# ─────────────────────────────────────────────────────────────────────────────

# VERIFY_PORT [необязательна]
# Что это: порт, на котором обход поднимает приложение.
# Если не задана: обход берёт свой порт по умолчанию (см. сам скрипт).
# Где взять: назначаете сами, если порт занят.
VERIFY_PORT=

# CHROMIUM_PATH [необязательна]
# Что это: путь к бинарнику браузера для обхода.
# Если не задана: берётся путь установки образа (см. сам скрипт).
# Где взять: `npx playwright install chromium` и путь из его вывода.
CHROMIUM_PATH=

# VERIFY_ONLY [необязательна]
# Что это: сузить обход до одного маршрута вместо всех.
# Если не задана: обходятся все маршруты.
# Где взять: маршрут из вывода обхода.
VERIFY_ONLY=

# ─────────────────────────────────────────────────────────────────────────────
# Вход в систему (apps/web)
# ─────────────────────────────────────────────────────────────────────────────

# SDELKA_AUTH_MODE [обязательна]
# Что это: режим канала доставки одноразового кода — `development` или
#   `production`. В `development` код печатается в журнал процесса и кука сессии
#   ставится без признака `Secure` (локальный сервер работает по http).
#   В `production` требуется боевой адаптер канала, и сегодня его нет ни одного.
# Если не задана: процесс не поднимается (отказ с именем переменной). Умолчания
#   здесь нет намеренно: забытая переменная означала бы работающий с виду вход,
#   в котором код виден всякому, у кого есть доступ к журналам.
# Где взять: назначаете сами при развёртывании. На рабочей машине —
#   `development`; `production` до появления боевого канала не поднимется, и это
#   верное поведение, а не поломка.
SDELKA_AUTH_MODE=

# SDELKA_AUTH_CODE_KEY [обязательна] [секрет]
# Что это: ключ, которым выводится одноразовый код входа. Самого кода нет ни в
#   базе, ни в журнале — ни открытым, ни отпечатком: он вычисляется из вызова
#   этим ключом. Тем же ключом считаются отпечатки устройства и сети для журнала
#   входов, с разделением назначений.
# Если не задана: процесс не поднимается (отказ с именем переменной).
# Где взять: сгенерировать случайную строку не короче 32 знаков и положить в
#   хранилище секретов. Например: `head -c 32 /dev/urandom | base64`. Смена ключа
#   гасит все выданные, но ещё не введённые коды — сессии при этом живут дальше.
SDELKA_AUTH_CODE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Резервная копия и проверенное восстановление (packages/backup)
# ─────────────────────────────────────────────────────────────────────────────

# SDELKA_BACKUP_DIR [обязательна]
# Что это: каталог, куда кладётся набор файлов копии.
# Если не задана: снятие копии отказывает с именем переменной.
# Где взять: назначаете сами. Копия несёт персональные данные и вечный журнал —
#   где ей можно лежать, а где нельзя, сказано в docs/OPERATIONS.md.
SDELKA_BACKUP_DIR=

# SDELKA_RESTORE_DATABASE_URL [обязательна] [секрет]
# Что это: база, в которую копия восстанавливается при проверке.
# Если не задана: проверка восстановления отказывает с именем переменной.
# Где взять: назначаете сами, отдельным адресом. Умолчания у неё нет намеренно:
#   эта база ПЕРЕСОЗДАЁТСЯ при каждой проверке, и умолчание, подставляющее сюда
#   боевой адрес, однажды его и снесёт.
SDELKA_RESTORE_DATABASE_URL=

# SDELKA_RESTORE_ADMIN_URL [необязательна] [секрет]
# Что это: служебная база того же кластера, из-под которой цель создаётся и
#   сносится: `DROP DATABASE` нельзя выполнить, подключившись к сносимой базе.
# Если не задана: берётся база `postgres` того же кластера — это имя служебной
#   базы, которое у Postgres одно, а не догадка об адресе.
# Где взять: у того же кластера, что и восстановление.
SDELKA_RESTORE_ADMIN_URL=
