# syntax=docker/dockerfile:1

# Образ `apps/web`: собирается из чистого клона монорепо, запускается
# непривилегированным пользователем, не несёт ни одного секрета.
#
# Здесь две цели, а не одна:
#   `runtime`  — процесс приложения. Собирается по умолчанию;
#   `migrator` — накат миграций (`packages/db`). **Отдельный шаг развёртывания,
#                отдельный образ и отдельная команда.** Приложение, мигрирующее
#                само себя на старте, при двух копиях делает это дважды и идёт в
#                базу правами, которых у него быть не должно (инвариант 21).
#
# Сборка:  docker build -t sdelka-web .
#          docker build --target migrator -t sdelka-migrate .
# Запуск:  docker run --rm -p 3000:3000 -e SDELKA_DATABASE_URL=... sdelka-web
#          docker run --rm -e PORT=8080 -p 8080:8080 -e SDELKA_DATABASE_URL=... sdelka-web
# Стек:    docker compose up -d --build   (см. `docs/DEPLOY.md`)
#
# Секреты (красная линия №12). В этом файле нет ни одного `ARG` под секрет и
# быть не может: значение `ARG` остаётся в истории слоёв и достаётся из образа
# командой `docker history` даже после того, как переменную «перетёрли».
# Всё, что тайна, приходит переменной окружения на `docker run` и в слои не
# попадает. Если однажды понадобится тайна на этапе сборки — только
# `RUN --mount=type=secret`, никогда не `ARG`.

# База закреплена дайджестом, а не тегом: `node:22-alpine` завтра указывает на
# другой образ, и «собирается из чистого клона» перестаёт значить «собирается
# тем же». Обновление — руками, одной строкой:
#   docker pull node:22-alpine && docker inspect --format='{{index .RepoDigests 0}}' node:22-alpine
#
# Почему alpine, а не debian-slim: проверено запуском, что официальный
# `node:22-alpine` собран с полным ICU (`process.config.variables.icu_small`
# = false) и даёт `Intl` тот же байт в байт, что среда разработки, — включая
# грузинскую локаль и лари. Для проекта на трёх языках это не деталь: усечённый
# ICU молча заменяет разметку чисел и дат английской, и ни сборка, ни тест без
# специальной проверки этого не показывают.
ARG NODE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

# --------------------------------------------------------------------- база
FROM ${NODE_IMAGE} AS base

# Версия pnpm — одна на весь репозиторий, поле `packageManager` в корневом
# `package.json`. Здесь она не повторяется намеренно: два места для одного
# числа расходятся молча.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NEXT_TELEMETRY_DISABLED=1

# Сеть, перехватывающая TLS (корпоративный прокси, песочница сборщика), обрывает
# и corepack, и загрузку пакетов: `SELF_SIGNED_CERT_IN_CHAIN`. Корневой
# сертификат такой сети — не секрет, но и не наше дело: он приходит снаружи
# необязательным `--secret` и **не остаётся ни в одном слое**, потому что
# `--mount=type=secret` виден только этой команде. Без него ступень проходит
# как раньше — `if` ниже не требует ничего.
#   docker build --secret id=ca_bundle,src=/путь/ca-bundle.crt .
# `ARG` для этого не годится ни при каких условиях: значение `ARG` достаётся из
# образа `docker history` (красная линия №12 — про секреты, но привычка
# «передам через ARG» одинаково плоха и здесь).
RUN --mount=type=secret,id=ca_bundle \
    if [ -s /run/secrets/ca_bundle ]; then \
      cat /run/secrets/ca_bundle >> /etc/ssl/certs/ca-certificates.crt; \
    fi

# Node на alpine не читает системное хранилище сам — только собственный набор
# корней плюс этот файл. Переменная стоит **только в ступенях сборки**: в образе
# исполнения ни одна сборочная сеть уже не участвует.
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

RUN corepack enable

WORKDIR /repo

# --------------------------------------------------------------- манифесты
# Из контекста отбираются только `package.json`, замок и описание workspace.
# Зачем отдельная ступень: `pnpm install --frozen-lockfile` сверяет перечень
# проектов с замком и падает, если хоть один пакет workspace не на месте.
# Перечислять манифесты руками нельзя — пакетов становится больше, и Dockerfile
# начал бы отставать от репозитория, ломая сборку на чужой правке. Здесь список
# берётся из самого контекста, поэтому новый пакет от этого файла ничего не
# требует.
FROM base AS manifests

COPY . /context
RUN set -eu; \
    mkdir -p /manifests; \
    cd /context; \
    cp package.json pnpm-lock.yaml pnpm-workspace.yaml /manifests/; \
    find . -mindepth 2 -name package.json -type f | while read -r manifest; do \
      mkdir -p "/manifests/$(dirname "$manifest")"; \
      cp "$manifest" "/manifests/$manifest"; \
    done

# ------------------------------------------------------------- зависимости
# Отдельная ступень ради кэша слоёв: пока набор манифестов и `pnpm-lock.yaml`
# байт в байт те же, установка не переигрывается, сколько бы раз ни менялись
# исходники. Сравнение идёт по содержимому скопированного, а не по тому,
# пересчитывалась ли ступень выше.
FROM base AS deps

COPY --from=manifests /manifests/ ./

# `--ignore-scripts`: ни один скрипт установки не нужен для `next build`, а
# выполнять чужой код из зависимостей на сборке — лишний вход. Заодно снимает
# загрузку браузеров playwright, которая иначе тянется ради стенда обхода.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --ignore-scripts

# ------------------------------------------------------------------ сборка
# Собирается один проект — `apps/web`, и `--filter` тому порукой. Исходники
# пакетов кладутся целиком: интерфейс тянет пять из них (money → ledger →
# domain → compliance → intake), но перечень зависимостей — дело манифестов, а
# не Dockerfile, и разъезжаться этим двум спискам незачем. В образ исполнения
# отсюда не попадает ничего, кроме прослеженного вывода: что нужно, решает
# трассировка Next, а не эта строка.
FROM deps AS build

COPY tsconfig.base.json ./
COPY packages packages
COPY apps/web apps/web

# `next build` здесь же проверяет типы: образ не соберётся из кода, который не
# проходит `tsc`.
RUN pnpm --filter @sdelka/web build

# ------------------------------------------------------------ накат миграций
# Отдельный образ под отдельный шаг развёртывания. Почему не «приложение
# мигрирует себя на старте»:
#
#   1. две копии приложения стартуют одновременно и накатывают одно и то же
#      дважды (раннер держит консультативную блокировку, но очередь из реплик,
#      ждущих чужую миграцию, — это не старт, а зависание);
#   2. накат идёт правами владельца схемы, приложение работает правами
#      `sdelka_app` и прав на изменение схемы не имеет вовсе (инвариант 21);
#   3. откат приложения на предыдущую сборку не должен откатывать базу.
#
# Порядок один и тот же везде: база готова → этот образ → приложение
# (`docs/DEPLOY.md`).
#
# Зависимости ставятся **своей** ступенью и только те, что нужны накату:
# `--filter "@sdelka/db..."` (пакет со своими зависимостями) и `--prod`. Ни
# next, ни react, ни vitest сюда не попадают — образ наката не место для
# сборщика интерфейса и прогонщика тестов.
FROM base AS migrator-deps

COPY --from=manifests /manifests/ ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --ignore-scripts --prod --filter "@sdelka/db..."

COPY tsconfig.base.json ./
COPY packages packages

# Чистая база: без pnpm и без corepack. Команда наката — тот же файл, который
# запускает `pnpm db:migrate` (`packages/db/package.json`), просто вызванный
# напрямую: второго раннера миграций в проекте нет и не будет.
FROM ${NODE_IMAGE} AS migrator

ENV NODE_ENV=production
WORKDIR /repo

RUN addgroup -g 10001 -S sdelka \
 && adduser  -u 10001 -S -G sdelka -h /repo -H -D sdelka

COPY --from=migrator-deps /repo /repo

USER sdelka:sdelka

# Ворота старта — тот же механизм, что у приложения (`pnpm env:check`), но
# суженный именем: накат читает строку подключения и больше ничего.
#
# Область `app` объединяет всё, что нужно приложению, а шагов у приложения
# несколько. Проверять здесь всю область значит требовать от того, кто
# накатывает схему, переменные входа в интерфейс: он их не читает, выставил бы
# любое значение — и ворота оказались бы обойдены. Обойдённые ворота хуже
# отсутствующих: они создают уверенность, которой не соответствуют.
#
# Контейнер, которому не хватает `SDELKA_DATABASE_URL`, обязан упасть сразу и
# назвать её, а не споткнуться об отсутствие соединения посреди наката.
ENTRYPOINT ["/bin/sh", "-c", "node --experimental-strip-types packages/config/src/cli/check-env.ts SDELKA_DATABASE_URL && exec \"$@\"", "sh"]
CMD ["node", "--experimental-strip-types", "packages/db/src/cli/migrate.ts"]

# -------------------------------------------------------------- исполнение
# Чистая база: ни pnpm, ни devDependencies, ни исходников, ни тестов. В образ
# приходит только `standalone` — самодостаточный вывод Next, куда трассировка
# положила ровно те модули, которые достижимы из кода.
FROM ${NODE_IMAGE} AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

WORKDIR /app

# Непривилегированный пользователь. Постоянный uid, а не выданный системой:
# при монтировании тома права должны совпадать предсказуемо.
RUN addgroup -g 10001 -S sdelka \
 && adduser  -u 10001 -S -G sdelka -h /app -H -D sdelka

# Три части вывода, и все три обязательны:
#   standalone       — `server.js` и прослеженные модули;
#   .next/static     — сборка клиента, Next кладёт её мимо standalone;
#   public           — статика, и в первую очередь `public/fonts`.
#
# Про шрифты отдельно. Гарнитуры лежат в репозитории (`apps/web/public/fonts`,
# рядом лежат тексты лицензий OFL — они обязаны ехать вместе со шрифтом).
# Без них интерфейс набирается системным шрифтом: сборка зелёная, снимок
# получается, а грузинский текст ломает раскладку — длины строк меряются
# обходом именно по этим гарнитурам. Дефект молчаливый, поэтому строка ниже
# существует отдельно и с комментарием.
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static     ./apps/web/.next/static
COPY --from=build /repo/apps/web/public           ./apps/web/public

# Ворота старта. Это **тот же** механизм, что `pnpm env:check`, а не второй:
# сюда едет исходник `packages/config` целиком, и запускается ровно та команда,
# что в корневом `package.json`. Проверок окружения в проекте одна, и перечень
# переменных у неё один (`packages/config/src/registry.ts`).
#
# Тестов и сборщиков здесь нет: `packages/config/test` не попадает даже в
# контекст сборки (`.dockerignore`), а типы с исходника снимает сам node.
COPY --from=build /repo/packages/config/src ./env-gate
# Манифест едет следом не для красоты: без `"type": "module"` node разбирает
# файл ворот дважды и пишет об этом предупреждением в журнал старта. Берётся
# настоящий манифест пакета, а не сочинённый здесь.
COPY --from=build /repo/packages/config/package.json ./env-gate/package.json

# Приложение владеет только кэшем Next и ничем больше: собственный код оно
# менять не должно.
RUN mkdir -p /app/apps/web/.next/cache \
 && chown -R sdelka:sdelka /app/apps/web/.next/cache

USER sdelka:sdelka

# Порт — из окружения, 3000 по умолчанию. `server.js` читает `PORT` и
# `HOSTNAME` сам.
EXPOSE ${PORT}

# Проба здоровья средствами самого Node: ни curl, ни wget в образ не ставятся.
#
# Спрашивается `/health`, а не `/`: корень отвечает перенаправлением на язык и
# доказывает ровно одно — процесс поднялся. Процесс, поднявшийся без базы,
# отвечает на порт и выглядит здоровым до первой денежной операции. `/health`
# отвечает `200` только когда база доступна и схема накачена
# (`apps/web/src/app/health/route.ts`), иначе `503`.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Ворота старта перед процессом: не хватает обязательной переменной — контейнер
# падает сразу, кодом 1, назвав имя переменной и того, кто её читает. Молчаливое
# умолчание вместо строки подключения было бы хуже отказа: приложение встало бы
# и отвечало не тем, что думает развернувший.
#
# `exec` в конце обязателен: иначе первым процессом остаётся `sh`, и SIGTERM от
# оркестратора приходит ему, а не node — контейнер гасится по сроку, обрывая
# соединения. Без init-обёртки намеренно: `next` сам вешает обработчики SIGTERM
# и SIGINT и закрывает соединения по-хорошему (`start-server.js`).
ENTRYPOINT ["/bin/sh", "-c", "node --experimental-strip-types /app/env-gate/cli/check-env.ts && exec \"$@\"", "sh"]
CMD ["node", "apps/web/server.js"]
