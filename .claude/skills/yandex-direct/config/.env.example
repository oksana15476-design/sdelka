# Опционально — только для пути C (свой Direct MCP на собственном OAuth).
# Пути A (Директ Коммандер) и B (кабинет через браузер) этот файл НЕ требуют.
#
# Токен OAuth Яндекс Директа (scope api для Директа). Выпускается на oauth.yandex.ru
# для своего приложения; НЕ коммитить реальный токен — config/.env в .gitignore.
YANDEX_DIRECT_TOKEN=your_oauth_token_here

# Логин рекламодателя (для агентских/множественных аккаунтов), опционально:
YANDEX_DIRECT_CLIENT_LOGIN=your_advertiser_login
